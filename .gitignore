# Source resume: its file still contains an unused object with the old
# header (phone + ZIP). Only the rebuilt copy in public/ is published.
/content/*.pdf

# Master resume: source of truth for facts, never pushed (contains phone and address).
/content/master-resume.txt
/content/master_resume.txt.txt

# Original photos (may carry EXIF/GPS). Only stripped web copies in public/info/ ship.
/content/photos/

# Builder agent notes (quote the master's notes to Nate). Local only, never pushed.
/.claude/agents/
